# LLM Providers
OPENAI_API_KEY=your_openai_key_here
GROQ_API_KEY=your_groq_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Data Providers
EODHD_API_KEY=your_eodhd_key_here

# Apify (Facebook Groups Scraper actor)
APIFY_API_TOKEN=your_apify_token_here

# Infrastructure (optional)
POSTGRES_URL=postgresql://user:pass@localhost/egx_trading
REDIS_URL=redis://localhost:6379

# Vector memory persistence path (ChromaDB PersistentClient).
# Defaults to ./chroma_db when unset. Directory is gitignored.
CHROMA_PERSIST_DIR=./chroma_db

# Memory backend selector: "chroma" (default) or "postgres".
# "postgres" requires installing the optional extra: `uv pip install -e .[postgres]`
# TRADINGAGENTS_MEMORY_BACKEND=chroma

# SECURITY: If your local .env was ever copied into version control or shared,
# rotate every key above (LLM, EODHD, Apify) AND the POSTGRES_URL password
# before exposing the repo. .env is in .gitignore but a prior commit could
# have leaked credentials.
